<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Allows the app to communicate with the Splash & Dash API. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".SplashDashApplication"
        android:allowBackup="true"
        android:icon="@drawable/splash_dash_logo"
        android:label="SplashDash"
        android:roundIcon="@drawable/splash_dash_logo"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.SplashDash">

        <!-- Splash screen: the first screen opened when the app launches. -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Main and home screen. -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Login and registration screens. -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- Customer screens. -->
        <activity
            android:name=".CustomerDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".BookingActivity"
            android:exported="false" />

        <activity
            android:name=".BookingHistoryActivity"
            android:exported="false" />

        <activity
            android:name=".PaymentActivity"
            android:exported="false" />

        <!-- Customer profile: view details and update the saved address. -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <!-- General information screens. -->
        <activity
            android:name=".GalleryActivity"
            android:exported="false" />

        <activity
            android:name=".ContactActivity"
            android:exported="false" />

        <!-- Settings and preferences. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

    </application>

</manifest>
